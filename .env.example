# Copy to .env (gitignored) and fill in.

# --- Database (used by both the mysql and app containers) ---
# The app connects as MYSQL_USER; the root password is only used by the mysql container.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=tripwire
MYSQL_PASSWORD=change-me

# --- Tripwire ---
# Public host name (prod). Dev overrides this to localhost:8080.
TRIPWIRE_DOMAIN=tripwire.example.com
ADMIN_EMAIL=admin@example.com

# EVE SSO app from https://developers.eveonline.com/applications
# Callback URL: https://<TRIPWIRE_DOMAIN>/index.php?mode=sso  (dev: http://localhost:8080/index.php?mode=sso)
EVE_SSO_CLIENT=
EVE_SSO_SECRET=

# Reverse proxy addresses (CIDRs, comma separated) whose X-Forwarded-For is trusted
# for the client IP, e.g. 172.16.0.0/12. Empty = use the connecting address.
TRUSTED_PROXIES=

# Optional overrides (defaults shown)
# TRIPWIRE_HTTPS=true
# EVE_SSO_REDIRECT=https://tripwire.example.com/index.php?mode=sso
# CDN_DOMAIN=tripwire.example.com
# APP_NAME=Tripwire
# TRIPWIRE_API=true
# Old API login with the account password (HTTP Basic). Off by default: use personal access tokens (Settings > General > API tokens). Set true only for old scripts
# TRIPWIRE_API_PASSWORD_AUTH=false
# API requests per token and minute
# TRIPWIRE_API_RATE_LIMIT=60
# ENABLE_SEARCH_SCOPE=true
# ENABLE_ASSETS_SCOPE=false   (true only after enabling esi-assets.read_assets.v1 on your CCP developer application)
# DISCORD_WEB_HOOK={"maskID":"https://discord.com/api/webhooks/..."}
# USER_AGENT=Tripwire Server - admin@example.com
# TZ=UTC   (keep UTC: signature times are stored in it; Discord notifications compare them)
# DB_WAIT_SECONDS=60
# DB_AUTO_INIT=true
# DB_SSL=true
# TRIPWIRE_IMAGE=petdog/tripwire:latest
# HTTP_PORT=8080

# Off by default; nothing is sent to third parties unless you set these (see docker/README.md).
# Your own Google Analytics 4 property:
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# HTML file (mounted into the container) shown in the page footer, e.g. your own donation panel:
# DONATION_PANEL_HTML_FILE=/config/donation.html

# Kill Reporting: zkill_feed.worker.php follows zKillboard once for the instance (false = the worker idles).
# ZKILL_FEED_ENABLED=true
# Corporation IDs (comma separated) whose kills/losses count as friendly for every user, besides their own corp:
# KILL_REPORT_FRIENDLY_CORPORATIONS=98839494
# Kills the worker keeps for the System Kill Feed and other readers, in hours (1-168):
# ZKILL_RETENTION_HOURS=48
# Days (0-90, 0 = off) the kills of systems people look at are kept for the System Threat 90-day profile
# ZKILL_THREAT_KEEP_DAYS=90
# Minimum seconds between the worker's zKillboard API requests (back-fills; the R2Z2 feed is paced separately):
# ZKILL_API_INTERVAL=2
# Pilots in shared local scans: the worker looks up their zKillboard stats (at most 20 per scan, lowest priority).
# false = corporations / alliances only (ESI), nothing is asked from zKillboard for local scans:
# INTEL_ZKILL_THREAT_ENABLED=true

# Audit log (Mask Admin > Audit): days to keep the record of who changed which signature or wormhole (1-3650, 0 = don't record)
# AUDIT_LOG_DAYS=60

# Discord notifications (Mask Admin > Discord): webhook URLs are stored encrypted with a key derived from this.
# Use a long random string (e.g. openssl rand -hex 32) and keep it: changing or removing it makes the stored
# webhooks unreadable (admins have to add them again). Unset = webhook URLs are stored unencrypted.
# DISCORD_SECRET_KEY=
