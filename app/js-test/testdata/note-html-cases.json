[
	{"name": "plain text and basic formatting kept", "input": "<b>hi</b> <i>there</i>", "contains": ["<b>hi</b>", "<i>there</i>"]},
	{"name": "script removed, text kept", "input": "a<script>alert(1)</script>b", "notContains": ["<script", "</script"], "contains": ["a", "b"]},
	{"name": "onerror with space before equals", "input": "<img src=x onerror =alert(1)>", "notContains": ["onerror"], "contains": ["<img"]},
	{"name": "upper-case ONERROR", "input": "<img src=x ONERROR=alert(1)>", "notContains": ["onerror"]},
	{"name": "onerror with newline and tab", "input": "<img src=x\nonerror\t=\nalert(1)>", "notContains": ["onerror"]},
	{"name": "unknown on* handler", "input": "<div onpointerover=\"alert(1)\">x</div>", "notContains": ["onpointerover", "alert"], "contains": ["x"]},
	{"name": "javascript: href", "input": "<a href=\"javascript:alert(1)\">x</a>", "notContains": ["javascript:", "href"], "contains": ["x"]},
	{"name": "javascript: href with leading whitespace", "input": "<a href=\" JaVaScRiPt:alert(1)\">x</a>", "notContains": ["javascript:"]},
	{"name": "data: img src", "input": "<img src=\"data:text/html,<script>alert(1)</script>\">", "notContains": ["data:", "<script"]},
