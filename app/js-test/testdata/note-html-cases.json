	{"name": "forbidden wrapper does not smuggle a child", "input": "<section><img src=x onerror=alert(1)></section>", "notContains": ["onerror", "<section"]},
	{"name": "iframe and object removed", "input": "<iframe src=\"https://evil.example/\"></iframe><object data=x></object>", "notContains": ["<iframe", "<object"]},
	{"name": "svg onload", "input": "<svg onload=alert(1)><circle/></svg>", "notContains": ["onload", "<svg"]},
	{"name": "comment dropped", "input": "x<!-- <script>alert(1)</script> -->y", "notContains": ["<!--", "<script"]},
	{"name": "style with url() dropped", "input": "<span style=\"background:url(javascript:alert(1))\">x</span>", "notContains": ["url(", "javascript"], "contains": ["x"]},
	{"name": "style keeps colour", "input": "<span style=\"color: #ff0000; position: fixed\">x</span>", "contains": ["color: #ff0000"], "notContains": ["position"]},
	{"name": "class and id dropped", "input": "<div class=\"sn\" id=\"a\" data-x=\"1\">x</div>", "notContains": ["class=", "id=", "data-x"], "contains": ["x"]},
	{"name": "script content that looks like markup", "input": "<script>x=\"<img src=x onerror=alert(1)>\"</script>", "notContains": ["onerror", "<img", "<script"]},
	{"name": "style content that looks like markup", "input": "<style><img src=x onerror=alert(1)></style>", "notContains": ["onerror", "<img", "<style"]},
	{"name": "textarea / xmp / noscript content removed", "input": "<textarea><img src=x onerror=alert(1)></textarea><xmp><img src=x onerror=alert(1)></xmp><noscript><img src=x onerror=alert(1)></noscript>", "notContains": ["onerror", "<img"]},
	{"name": "ckeditor font sizes and family kept", "input": "<span style=\"font-size: 22px; font-family: Arial, 'Times New Roman', sans-serif\">x</span><span style=\"font-size:72px\">y</span>", "contains": ["font-size: 22px", "font-family: Arial", "font-size: 72px"]},
	{"name": "font-family cannot carry markup or url", "input": "<span style=\"font-family: a;background:url(x)\">x</span><span style=\"font-family: x&quot;&gt;&lt;img&quot;\">y</span>", "notContains": ["url(", "<img"]},
	{"name": "indent kept, other lengths dropped", "input": "<p style=\"margin-left: 40px; padding-left: 10px; margin-right: 5px\">x</p>", "contains": ["margin-left: 40px", "padding-left: 10px"], "notContains": ["margin-right"]},
	{"name": "table attributes and code/small kept", "input": "<table border=\"1\" cellpadding=\"2\" cellspacing=\"0\" align=\"center\" width=\"100%\"><tr><td width=\"50\" align=\"left\"><code>a</code><small>b</small></td></tr></table>", "contains": ["border=\"1\"", "cellpadding=\"2\"", "width=\"100%\"", "align=\"center\"", "<code>a</code>", "<small>b</small>"]},
	{"name": "table attribute with junk value dropped", "input": "<table width=\"expression(alert(1))\"><tr><td>x</td></tr></table>", "notContains": ["expression", "width="]},
